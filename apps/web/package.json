{
  "name": "@tripnote/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm sync:images && next dev",
    "build": "pnpm sync:images && next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "gen:icons": "node scripts/build-icons.mjs",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/lib/api/schema.d.ts",
    "sync:images": "node scripts/sync-images.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "@tripnote/design-tokens": "workspace:*",
    "next": "16.4.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  }
}
