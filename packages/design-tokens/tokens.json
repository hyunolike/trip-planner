{
  "$description": "여행노트 디자인 토큰. design-system/tokens.json에서 변환했고, 이후에는 이 파일이 원본이다. 고친 뒤 pnpm --filter @tripnote/design-tokens build를 돌린다.",
  "color": {
    "canvas": {
      "$type": "color",
      "$value": "#f7f8fa",
      "$description": "페이지 배경. 모든 화면의 바닥면. 섹션 사이 구분은 이 색과 surface의 단차로만 한다.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#0f1216"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "카드, 시트, 상단 바, 목록 행의 면. canvas 위에 놓인다.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#161a20"
        }
      }
    },
    "surface-sunken": {
      "$type": "color",
      "$value": "#eef1f5",
      "$description": "입력창 배경, 세그먼트 컨트롤 트랙, 비활성 칩, 지도 플레이스홀더.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#1e232b"
        }
      }
    },
    "surface-brand": {
      "$type": "color",
      "$value": "#e7edfb",
      "$description": "선택된 날짜, 선택된 탭, 브랜드 톤 알림면. 위에는 brand 텍스트(light) 또는 brand(dark)를 올린다.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#1c2740"
        }
      }
    },
    "line": {
      "$type": "color",
      "$value": "#e2e6ec",
      "$description": "구분선, 카드 외곽선, 입력창 기본 테두리. 의미를 전달하지 않는 선.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#2a313b"
        }
      }
    },
    "line-strong": {
      "$type": "color",
      "$value": "#c9cfd8",
      "$description": "체크박스·라디오 기본 테두리, 드래그 핸들 점. 의미를 가진 선이라 3:1 이상을 지킨다.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#3a4350"
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#171b22",
      "$description": "본문·제목 텍스트, 아이콘. surface와 canvas 위에서 15:1 이상.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#eceff3"
        }
      }
    },
    "ink-muted": {
      "$type": "color",
      "$value": "#5b6472",
      "$description": "보조 텍스트: 소요시간, 위치, 확인일, 캡션. surface·canvas·surface-sunken 위 4.5:1 이상.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#a4adba"
        }
      }
    },
    "ink-faint": {
      "$type": "color",
      "$value": "#8a93a2",
      "$description": "플레이스홀더, 비활성 텍스트, 장식 아이콘. 본문에는 쓰지 않는다(3.3:1). 24px 이상 또는 비활성 상태에만.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#717b89"
        }
      }
    },
    "brand": {
      "$type": "color",
      "$value": "#2456d6",
      "$description": "하나뿐인 액션 색. 기본 버튼 채움, 링크, 선택된 날짜 밑줄, 지도 현재 스톱. surface 위 6.2:1(light), 6.6:1(dark).",
      "$extensions": {
        "app.tripnote": {
          "dark": "#7a9bf7"
        }
      }
    },
    "brand-hover": {
      "$type": "color",
      "$value": "#1b45b3",
      "$description": "brand의 hover·active. 포커스 링은 별도 focus-ring을 쓴다.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#93aefa"
        }
      }
    },
    "on-brand": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "brand 채움 위 텍스트와 아이콘. dark에서는 brand가 밝아지므로 어두운 잉크를 쓴다.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#0f1216"
        }
      }
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#2456d6",
      "$description": "키보드 포커스 링. 2px 실선, 2px 오프셋. 모든 면 위에서 3:1 이상.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#93aefa"
        }
      }
    },
    "success": {
      "$type": "color",
      "$value": "#177a44",
      "$description": "방문 완료 체크, 저장됨 상태, 예약 확정 배지. 항상 아이콘이나 단어와 함께 쓴다.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#5cc48a"
        }
      }
    },
    "success-soft": {
      "$type": "color",
      "$value": "#e3f3ea",
      "$description": "success 배지와 완료 행의 배경.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#15301f"
        }
      }
    },
    "warning": {
      "$type": "color",
      "$value": "#a3570a",
      "$description": "출발 목표·버퍼 경고, 방문 전 확인 필요, 면세 조건 확인. 텍스트로 쓸 때 surface 위 5.3:1.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#e39a3b"
        }
      }
    },
    "warning-soft": {
      "$type": "color",
      "$value": "#fbeedd",
      "$description": "warning 배지와 안내면의 배경.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#3a2710"
        }
      }
    },
    "danger": {
      "$type": "color",
      "$value": "#cf3a32",
      "$description": "삭제, 저장 실패, 티켓 없이는 승선 불가 같은 되돌릴 수 없는 경고. 텍스트 버튼과 배지에만.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#f0756c"
        }
      }
    },
    "danger-soft": {
      "$type": "color",
      "$value": "#fde8e6",
      "$description": "danger 배지와 오류 안내면의 배경.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#3d1a18"
        }
      }
    },
    "transit-flight": {
      "$type": "color",
      "$value": "#6d4bd8",
      "$description": "지도 경로선과 이동 수단 칩: 항공. 교통 색은 brand와 별개로 의미를 유지한다.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#a48cf2"
        }
      }
    },
    "transit-train": {
      "$type": "color",
      "$value": "#2456d6",
      "$description": "지도 경로선과 이동 수단 칩: 철도·지하철.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#7a9bf7"
        }
      }
    },
    "transit-bus": {
      "$type": "color",
      "$value": "#a3570a",
      "$description": "지도 경로선과 이동 수단 칩: 버스·리무진.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#e39a3b"
        }
      }
    },
    "transit-walk": {
      "$type": "color",
      "$value": "#177a44",
      "$description": "지도 경로선과 이동 수단 칩: 도보. 점선으로 그린다.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#5cc48a"
        }
      }
    },
    "transit-boat": {
      "$type": "color",
      "$value": "#0a7a8c",
      "$description": "지도 경로선과 이동 수단 칩: 선박·크루즈.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#4fc3d6"
        }
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "#171b2299",
      "$description": "바텀시트·모달 뒤 딤 처리. 60% 불투명.",
      "$extensions": {
        "app.tripnote": {
          "dark": "#00000099"
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "\"Gowun Batang\", \"Apple SD Gothic Neo\", \"Noto Serif KR\", serif"
    },
    "sans": {
      "$type": "fontFamily",
      "$value": "\"IBM Plex Sans KR\", \"Apple SD Gothic Neo\", \"Noto Sans KR\", system-ui, sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "\"IBM Plex Mono\", \"SF Mono\", Menlo, Consolas, monospace"
    }
  },
  "text": {
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "40px",
        "lineHeight": "48px",
        "fontWeight": 700,
        "letterSpacing": "-0.01em"
      },
      "$description": "데스크톱 여행 제목, 홈 헤드라인. 한 화면에 하나."
    },
    "display-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "28px",
        "lineHeight": "36px",
        "fontWeight": 700,
        "letterSpacing": "-0.01em"
      },
      "$description": "모바일 여행 제목, 여행 카드의 큰 제목."
    },
    "display-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "22px",
        "lineHeight": "30px",
        "fontWeight": 700
      },
      "$description": "날짜별 테마 문장. 일정 리스트 맨 위 한 줄."
    },
    "title-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "22px",
        "lineHeight": "30px",
        "fontWeight": 600
      },
      "$description": "섹션 제목(일정·맛집·쇼핑·링크·준비)."
    },
    "title-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "18px",
        "lineHeight": "26px",
        "fontWeight": 600
      },
      "$description": "스톱 제목(모바일), 카드 제목, 시트 제목."
    },
    "title-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 600
      },
      "$description": "체크리스트 그룹 제목, 목록 소제목."
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "17px",
        "lineHeight": "28px",
        "fontWeight": 400
      },
      "$description": "스톱 상세 본문. 긴 안내문은 이 크기로 읽힌다."
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "15px",
        "lineHeight": "24px",
        "fontWeight": 400
      },
      "$description": "기본 본문, 카드 설명, 입력 텍스트."
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "14px",
        "lineHeight": "22px",
        "fontWeight": 400
      },
      "$description": "소요시간·위치 같은 보조 정보, 버튼 라벨(보조)."
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "13px",
        "lineHeight": "18px",
        "fontWeight": 500,
        "letterSpacing": "0.02em"
      },
      "$description": "배지, 탭 라벨, 상태 라벨. 대문자 영문은 0.04em."
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 400
      },
      "$description": "확인일, 출처, 사진 캡션. ink-muted로."
    },
    "data-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "20px",
        "lineHeight": "24px",
        "fontWeight": 500
      },
      "$description": "스톱 시각, 카운트다운 숫자. tabular-nums."
    },
    "data": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 500
      },
      "$description": "공항 코드, 편명, 날짜 바의 날짜, 가격(¥1,200)."
    },
    "data-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 500
      },
      "$description": "역 코드, 좌표, 작은 타임스탬프."
    }
  },
  "space": {
    "space-1": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "아이콘과 라벨 사이, 배지 안 세로 여백."
    },
    "space-2": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "칩 사이, 버튼 안 아이콘 간격, 목록 행 안 세로 간격."
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "버튼 가로 안쪽 여백(sm), 카드 안 요소 간격."
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "카드·시트 안쪽 여백, 360px 미만 화면의 좌우 거터."
    },
    "space-5": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "모바일 좌우 거터, 스톱 행 세로 여백."
    },
    "space-6": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "데스크톱 좌우 거터, 섹션 안 블록 간격."
    },
    "space-8": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "섹션 사이(모바일)."
    },
    "space-10": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "섹션 사이(데스크톱), 빈 상태 위아래."
    },
    "space-12": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "페이지 상단 여백(데스크톱), 히어로 아래."
    },
    "space-16": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "하단 내비게이션 높이 + 안전 영역을 위한 페이지 바닥 여백."
    }
  },
  "radius": {
    "radius-xs": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "체크박스, 작은 배지, 코드 칩."
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "버튼, 입력창, 세그먼트 컨트롤 트랙."
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "카드, 사진 썸네일, 알림면."
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "바텀시트 상단, 모달, 큰 사진."
    },
    "radius-full": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "칩, 아바타, 플로팅 버튼, 진행 막대."
    }
  },
  "shadow": {
    "shadow-sm": {
      "$type": "shadow",
      "$value": "0 1px 2px #171b220f",
      "$description": "sticky 날짜 바, 상단 바가 스크롤 위에 떠 있을 때.",
      "$extensions": {
        "app.tripnote": {
          "dark": "0 1px 2px #00000066"
        }
      }
    },
    "shadow-md": {
      "$type": "shadow",
      "$value": "0 4px 12px #171b2214",
      "$description": "토스트, 드롭다운, 드래그 중인 스톱 행.",
      "$extensions": {
        "app.tripnote": {
          "dark": "0 4px 12px #00000080"
        }
      }
    },
    "shadow-sheet": {
      "$type": "shadow",
      "$value": "0 -8px 24px #171b221f",
      "$description": "바텀시트. 카드에는 그림자 대신 line 테두리를 쓴다.",
      "$extensions": {
        "app.tripnote": {
          "dark": "0 -8px 24px #00000099"
        }
      }
    }
  },
  "size": {
    "control-sm": {
      "$type": "dimension",
      "$value": "36px",
      "$description": "칩, 보조 버튼, 세그먼트 컨트롤 높이. 터치 영역은 44px로 늘린다."
    },
    "control-md": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "기본 버튼·입력창 높이. 최소 터치 타깃."
    },
    "control-lg": {
      "$type": "dimension",
      "$value": "52px",
      "$description": "주요 액션 버튼(시트 하단), 로그인 버튼."
    },
    "nav-height": {
      "$type": "dimension",
      "$value": "56px",
      "$description": "상단 바와 하단 내비게이션 높이(안전 영역 제외)."
    },
    "container-sm": {
      "$type": "dimension",
      "$value": "640px",
      "$description": "모바일·태블릿 본문 최대 너비. 일정 리스트 열 너비."
    },
    "container-lg": {
      "$type": "dimension",
      "$value": "1200px",
      "$description": "데스크톱 2열 레이아웃 최대 너비."
    },
    "map-mobile": {
      "$type": "dimension",
      "$value": "45vh",
      "$description": "모바일 섹션 안 지도 높이."
    }
  }
}
