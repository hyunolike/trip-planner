{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tripnote.local/schema/trip.schema.json",
  "title": "여행노트 샘플 여행",
  "description": "SampleTripSeeder가 적재하는 여행 한 건. 설계 문서 3.3 데이터 모델의 테이블과 1:1로 대응한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "title", "startDate", "endDate", "visibility", "isSample", "days", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]{3,64}$" },
    "title": { "type": "string", "maxLength": 60 },
    "subtitle": { "type": "string", "maxLength": 120 },
    "startDate": { "type": "string", "format": "date" },
    "endDate": { "type": "string", "format": "date" },
    "timezone": { "type": "string", "description": "IANA 이름. 스톱 시각은 이 시간대의 현지 시각이다.", "examples": ["Asia/Tokyo"] },
    "visibility": { "enum": ["private", "link", "public"] },
    "isSample": { "type": "boolean" },
    "coverPhoto": { "$ref": "#/$defs/photo" },
    "travelers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label"], "properties": { "label": { "type": "string" }, "emoji": { "type": "string" } } } },
    "flights": { "type": "array", "items": { "$ref": "#/$defs/flight" } },
    "route": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "label"], "properties": { "code": { "type": "string" }, "label": { "type": "string" }, "vehicle": { "type": "string" }, "vehicleLabel": { "type": "string" } } } },
    "days": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/day" } },
    "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
    "linkGroups": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "links"], "properties": { "label": { "type": "string" }, "links": { "type": "array", "items": { "$ref": "#/$defs/link" } } } } },
    "checklistGroups": { "type": "array", "items": { "$ref": "#/$defs/checklistGroup" } },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "link": { "type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": { "label": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "note": { "type": "string" } } },
    "photo": { "type": "object", "additionalProperties": false, "required": ["src", "alt"], "properties": { "src": { "type": "string" }, "alt": { "type": "string" }, "credit": { "type": "string" }, "license": { "type": "string" }, "sourceUrl": { "type": "string", "format": "uri" } } },
    "coordinates": { "type": "array", "prefixItems": [ { "type": "number", "minimum": -90, "maximum": 90 }, { "type": "number", "minimum": -180, "maximum": 180 } ], "items": false, "minItems": 2, "description": "[위도, 경도]" },
    "flight": { "type": "object", "additionalProperties": false, "required": ["direction", "from", "to", "date", "depart", "arrive"], "properties": { "direction": { "enum": ["outbound", "return"] }, "airline": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "date": { "type": "string", "format": "date" }, "depart": { "$ref": "#/$defs/time" }, "arrive": { "$ref": "#/$defs/time" }, "arrivesNextDay": { "type": "boolean" }, "note": { "type": "string" } } },
    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "transit": { "type": "object", "additionalProperties": false, "required": ["mode", "label"], "properties": { "mode": { "enum": ["flight", "train", "bus", "walk", "boat", "taxi", "car"] }, "label": { "type": "string" }, "icon": { "type": "string" }, "waypoints": { "type": "array", "items": { "$ref": "#/$defs/coordinates" } } } },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "time", "title", "type", "details"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "time": { "$ref": "#/$defs/time" },
        "title": { "type": "string", "maxLength": 80 },
        "type": { "enum": ["airport", "flight", "transport", "hotel", "meal", "sight", "shopping", "free"] },
        "details": { "type": "string" },
        "duration": { "type": "string" },
        "buffer": { "type": "string" },
        "timing": { "type": "string", "description": "근거 수준. 예약 확정, 가족 계획, 상품 안내, 방문 전 확인 중 하나 또는 자유 문구." },
        "transportIcon": { "type": "string" },
        "coordinates": { "$ref": "#/$defs/coordinates" },
        "approximate": { "type": "boolean" },
        "transit": { "$ref": "#/$defs/transit" },
        "photo": { "$ref": "#/$defs/photo" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "placeId": { "type": "string" },
        "optional": { "type": "boolean", "description": "선택 일정. 늦어지면 생략할 수 있다." },
        "guide": { "$ref": "#/$defs/guide" }
      }
    },
    "guide": { "type": "object", "additionalProperties": false, "required": ["kind", "title", "blocks"], "properties": { "kind": { "enum": ["place", "hotel", "breakfast", "transit", "course", "airport"] }, "title": { "type": "string" }, "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } } } },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["paragraph", "steps", "facts", "tips", "image", "links", "html"] } },
      "description": "paragraph{text}, steps{items[]}, facts{items[[k,v]]}, tips{items[]}, image{photo}, links{items[link]}. html은 기존 데이터 이관에만 허용한다."
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "date", "city", "theme", "stops"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "format": "date" },
        "city": { "type": "string" },
        "theme": { "type": "string" },
        "note": { "type": "string" },
        "color": { "type": "string" },
        "stops": { "type": "array", "items": { "$ref": "#/$defs/stop" } }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "area"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": { "enum": ["dining", "shopping", "hotel", "sight"] },
        "name": { "type": "string" },
        "branch": { "type": "string" },
        "area": { "type": "string" },
        "category": { "type": "string" },
        "items": { "type": "string" },
        "menu": { "type": "string" },
        "address": { "type": "string" },
        "hours": { "type": "string" },
        "coordinates": { "$ref": "#/$defs/coordinates" },
        "mapUrl": { "type": "string", "format": "uri" },
        "note": { "type": "string" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "checkedAt": { "type": "string" }
      }
    },
    "checklistGroup": { "type": "object", "additionalProperties": false, "required": ["id", "title", "items"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "hint": { "type": "string" }, "items": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "priority", "title"], "properties": { "id": { "type": "string" }, "priority": { "enum": ["필수", "필수 확인", "개인 필수", "권장"] }, "title": { "type": "string" }, "description": { "type": "string" } } } } } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "createdAt"],
      "properties": {
        "kind": { "enum": ["family-original", "researched-example"] },
        "createdAt": { "type": "string", "format": "date" },
        "method": { "type": "string" },
        "referencedProducts": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "disclaimer": { "type": "string" }
      }
    }
  }
}
